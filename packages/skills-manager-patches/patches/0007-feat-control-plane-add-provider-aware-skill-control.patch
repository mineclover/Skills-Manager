+                    skill_dir.join("SKILL.md"),
+                    format!("---\nname: {name}\n---\n"),
+                )
+                .expect("write Codex skill");
+            }
+
+            let mut config = AppConfig::default();
+            config.initialized = true;
+            config.tools.insert(
+                "codex".to_string(),
