+        let config = manager.load()?;
+        let id: String = name
+            .trim()
+            .to_lowercase()
+            .chars()
+            .map(|character| if character == ' ' { '-' } else { character })
+            .filter(|character| {
+                character.is_alphanumeric() || *character == '-' || *character == '_'
+            })
+            .collect();
